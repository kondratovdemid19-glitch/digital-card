{
  "name": "demid-digital-card",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "prisma generate && tsc && cp src/profile/profile.graphql dist/src/profile/profile.graphql",
    "start": "node dist/src/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/prisma/seed.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/profile.test.js"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/client": "6.19.3",
    "graphql": "16.11.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "overrides": {
    "@graphql-tools/utils": "12.0.2",
    "multer": "2.5.0",
    "deepmerge-ts": "8.0.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
